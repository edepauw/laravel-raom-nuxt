{
    "name": "laravel-raom-nuxt",
    "version": "0.3.7",
    "description": "Nuxt module providing a typed object-mapper for Laravel REST API backends. Offers model classes with decorator-based field/key/relation metadata (@Resource, @Field, @Key), identity map, query builder, and relation builders (HasMany, BelongsTo, BelongsToMany, HasOne) with deferred mutation support.",
    "repository": "https://github.com/edepauw/laravel-raom-nuxt",
    "author": "edepauw",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
        },
        "./composables": {
            "types": "./dist/runtime/index.d.ts",
            "import": "./dist/runtime/index.js"
        },
        "./runtime": {
            "types": "./dist/runtime/index.d.ts",
            "import": "./dist/runtime/index.js"
        }
    },
    "main": "./dist/module.mjs",
    "typesVersions": {
        "*": {
            ".": [
                "./dist/types.d.mts"
            ]
        }
    },
    "files": [
        "dist"
    ],
    "workspaces": [
        "playground"
    ],
    "scripts": {
        "prepack": "nuxt-module-build build",
        "dev": "npm run dev:prepare && nuxt dev playground",
        "dev:build": "nuxt build playground",
        "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
        "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
        "lint": "eslint .",
        "test": "vitest run",
        "test:ui": "vitest --ui",
        "test:watch": "vitest watch",
        "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
    },
    "dependencies": {
        "@nuxt/kit": "^4.4.2"
    },
    "devDependencies": {
        "@nuxt/devtools": "^3.2.3",
        "@nuxt/eslint-config": "^1.15.2",
        "@nuxt/module-builder": "^1.0.2",
        "@nuxt/schema": "^4.4.2",
        "@nuxt/test-utils": "^4.0.0",
        "@types/node": "latest",
        "@vitest/ui": "^4.1.0",
        "changelogen": "^0.6.2",
        "eslint": "^10.0.3",
        "nuxt": "^4.4.2",
        "typescript": "~5.9.3",
        "vitest": "^4.0.18",
        "vue-tsc": "^3.2.5"
    }
}
